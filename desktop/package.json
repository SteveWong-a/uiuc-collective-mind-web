{
  "name": "uiuc-collective-mind-desktop",
  "version": "0.1.0",
  "description": "UIUC Collective Mind Desktop App",
  "author": "UIUC Collective Mind Contributors",
  "homepage": "https://github.com/uiucDavid/uiuc_collective_mind",
  "repository": {
    "type": "git",
